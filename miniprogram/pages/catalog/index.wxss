.catalog-page { padding-right: 18rpx; padding-left: 18rpx; }
.catalog-topbar { padding-right: 6rpx; padding-left: 6rpx; }
.result-count { color: #817d6c; font-size: 22rpx; }
.search-box { height: 78rpx; margin: 16rpx 6rpx 0; padding: 0 24rpx; border: 1rpx solid #dfe5de; border-radius: 39rpx; background: #ffffff; display: flex; align-items: center; gap: 15rpx; }
.search-icon { color: #686556; font-family: Georgia, serif; font-size: 34rpx; }
.search-box input { min-width: 0; flex: 1; font-size: 24rpx; }
.search-placeholder { color: #aaa596; }

.catalog-split { margin-top: 24rpx; padding-bottom: 30rpx; display: flex; align-items: flex-start; gap: 16rpx; }
.category-rail { width: 196rpx; flex: 0 0 196rpx; padding-bottom: 28rpx; border-right: 1rpx solid #dcd7ca; position: sticky; top: 12rpx; }
.category-rail button { width: 100%; padding: 0; border: 0; color: #6e6a5c; background: transparent; text-align: left; }
.rail-latest { min-height: 92rpx; padding: 0 20rpx 0 16rpx !important; position: relative; display: flex; align-items: center; justify-content: space-between; font-size: 29rpx; font-weight: 700; line-height: 1.25; }
.rail-latest i { width: 10rpx; height: 10rpx; border-radius: 50%; background: transparent; }
.rail-latest.active { color: #242a25; }
.rail-latest.active i { background: #59624f; box-shadow: 0 0 0 7rpx rgba(89,98,79,.12); }
.rail-group { border-top: 1rpx solid #e5e8e3; }
.rail-group-button { min-height: 88rpx; padding: 0 18rpx 0 16rpx !important; display: flex; align-items: center; justify-content: space-between; font-size: 27rpx; font-weight: 650; line-height: 1.3; }
.rail-group-button i { min-width: 30rpx; color: #807b6d; font-size: 29rpx; font-style: normal; font-weight: 400; text-align: right; }
.rail-group-button.expanded { color: #222a25; }
.rail-tags { padding: 0 8rpx 20rpx 16rpx; animation: rail-open .18s ease both; }
@keyframes rail-open { from { opacity: 0; transform: translateY(-6rpx); } to { opacity: 1; transform: none; } }
.rail-tag { min-height: 78rpx; padding: 8rpx 12rpx 8rpx 16rpx !important; border-left: 3rpx solid #dcd7ca !important; position: relative; display: flex; align-items: center; justify-content: space-between; font-size: 25rpx; line-height: 1.3; white-space: nowrap; }
.rail-tag.active { color: #59624f; border-left-color: #59624f !important; background: linear-gradient(90deg, rgba(89,98,79,.09), transparent); font-weight: 700; }
.rail-tag i { width: 9rpx; height: 9rpx; border-radius: 50%; background: #c75029; }

.catalog-results { min-width: 0; flex: 1; }
.results-heading { min-height: 72rpx; padding: 0 4rpx 12rpx; display: flex; align-items: flex-end; justify-content: space-between; }
.results-heading > view text { display: block; }
.results-heading .eyebrow { color: #9a806e; font-size: 16rpx; letter-spacing: 3rpx; }
.results-title { margin-top: 7rpx; color: #242a25; font-family: "Songti SC", serif; font-size: 31rpx; font-weight: 700; }
.results-heading > text { color: #969184; font: 20rpx Georgia, serif; }

.compact-product-card { min-height: 190rpx; margin-bottom: 14rpx; border: 1rpx solid #e5e8e3; border-radius: 10rpx 24rpx 10rpx 24rpx; background: #ffffff; box-shadow: 0 8rpx 22rpx rgba(38,43,37,.05); overflow: hidden; position: relative; display: grid; grid-template-columns: 158rpx minmax(0, 1fr); }
.compact-product-card:active { transform: scale(.988); background: #fff; }
.compact-image-wrap { min-height: 190rpx; position: relative; background: #d7d4ca; }
.compact-image { width: 100%; height: 100%; position: absolute; inset: 0; }
.compact-color-count { position: absolute; right: 9rpx; bottom: 9rpx; padding: 5rpx 9rpx; border-radius: 13rpx; color: #4d554b; background: rgba(255,255,255,.92); font-size: 16rpx; font-weight: 700; }
.compact-content { min-width: 0; padding: 16rpx 12rpx 10rpx 16rpx; display: flex; flex-direction: column; }
.compact-code-row { display: flex; align-items: center; justify-content: space-between; }
.compact-code { color: #9a735f; font: italic 18rpx Georgia, serif; letter-spacing: 1rpx; }
.compact-arrow { color: #9c978a; font-size: 20rpx; }
.compact-title { margin-top: 7rpx; overflow: hidden; color: #272b27; font-family: "Songti SC", serif; font-size: 25rpx; font-weight: 700; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.compact-composition { margin-top: 7rpx; overflow: hidden; color: #7a7669; font-size: 17rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.compact-footer { min-width: 0; margin-top: auto; display: flex; align-items: flex-end; gap: 6rpx; }
.compact-meta { min-width: 0; flex: 1; }
.compact-specs { color: #56574f; display: flex; align-items: center; gap: 9rpx; font-size: 18rpx; }
.compact-specs i { width: 1rpx; height: 17rpx; background: #ccc7ba; }
.compact-tags { margin-top: 9rpx; display: flex; gap: 7rpx; overflow: hidden; }
.compact-tags text { padding: 4rpx 8rpx; border-radius: 11rpx; color: #657064; background: #eef1ec; font-size: 15rpx; white-space: nowrap; }
.favorite-button { width: 58rpx; height: 54rpx; flex: 0 0 58rpx; color: #c8c4bb; font-family: Arial, sans-serif; font-size: 40rpx; line-height: 1; display: flex; align-items: center; justify-content: center; transition: color .15s ease, transform .15s ease; }
.favorite-button.is-favorite { color: #f12e3c; }
.favorite-button:active { transform: scale(.84); }

.catalog-empty { min-height: 360rpx; padding: 60rpx 24rpx; border: 1rpx dashed #c9c3b5; border-radius: 12rpx 26rpx 12rpx 26rpx; color: #7d786b; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.empty-mark { width: 58rpx; height: 58rpx; border-radius: 50%; background: #eef1ec; display: grid; place-items: center; font-size: 30rpx; }
.empty-title { margin-top: 20rpx; color: #45473f; font-size: 23rpx; font-weight: 700; }
.empty-copy { margin-top: 10rpx; font-size: 19rpx; line-height: 1.6; }
.catalog-end { padding: 22rpx 0 8rpx; color: #aaa497; font-size: 18rpx; text-align: center; }
