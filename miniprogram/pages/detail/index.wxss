.detail-page { min-height: 100vh; padding-bottom: calc(env(safe-area-inset-bottom) + 330rpx); background: #ffffff; }
.detail-topbar { position: absolute; z-index: 5; top: 98rpx; right: 24rpx; left: 24rpx; height: 68rpx; }
.detail-topbar .brand-lockup { position: absolute; top: 50%; left: 50%; max-width: calc(100% - 180rpx); transform: translate(-50%, -50%); }
.circle-button { position: absolute; top: 50%; width: 58rpx; min-width: 58rpx; max-width: 58rpx; height: 58rpx; min-height: 58rpx; padding: 0; border-radius: 50%; background: rgba(255,255,255,.94); color: #33342e; font-size: 24rpx; line-height: 1; transform: translateY(-50%); display: flex; align-items: center; justify-content: center; }
.back-button { left: 0; }
.share-button { right: 176rpx; }
.detail-brand { color: #fff; font-size: 27rpx; font-weight: 800; white-space: nowrap; text-shadow: 0 2rpx 8rpx rgba(0,0,0,.25); }
.gallery-wrap { position: relative; }
.gallery { height: 860rpx; }
.gallery-image { width: 100%; height: 100%; }
.gallery-counter { position: absolute; right: 28rpx; bottom: 24rpx; padding: 12rpx 20rpx; border-radius: 24rpx; background: rgba(27,27,24,.68); color: #fff; font-size: 21rpx; }
.detail-body { padding: 40rpx 28rpx 40rpx; }
.detail-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.detail-title { display: block; font-family: "Songti SC", serif; font-size: 48rpx; font-weight: 700; }
.detail-code { margin-top: 28rpx; color: #77725e; font-family: Georgia, serif; font-size: 28rpx; font-style: italic; }
.detail-intro { display: block; margin-top: 24rpx; color: #686457; font-size: 26rpx; line-height: 1.85; }
.detail-quote { display: block; margin-top: 22rpx; color: #30312c; font-family: "Songti SC", serif; font-size: 36rpx; font-weight: 700; }
.tag-row { margin-top: 24rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.detail-section { margin-top: 56rpx; }
.detail-section-head { display: flex; align-items: center; justify-content: space-between; }
.detail-section-title { display: block; margin-bottom: 24rpx; font-family: "Songti SC", serif; font-size: 38rpx; font-weight: 700; }
.detail-note { color: #817c6a; font-size: 21rpx; }
.spec-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.spec { min-height: 178rpx; padding: 24rpx; border: 1rpx solid #e5e8e3; border-radius: 26rpx; background: #ffffff; display: flex; flex-direction: column; justify-content: space-between; }
.spec-wide { grid-column: 1 / -1; min-height: 158rpx; }
.spec-label { color: #8a8574; font-size: 21rpx; }
.spec-value { color: #32332d; font-family: Georgia, "PingFang SC", sans-serif; font-size: 30rpx; font-weight: 700; white-space: pre-line; }
.spec-value.long { font-size: 22rpx; line-height: 1.5; }
.composition-value { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8rpx 18rpx; }
.composition-token { display: inline-block; max-width: 100%; color: #32332d; font-family: Georgia, "PingFang SC", sans-serif; font-size: 30rpx; font-weight: 700; line-height: 1.45; white-space: nowrap; }
.color-card { width: 100%; }
.use-list { border-top: 1rpx solid #e5e8e3; }
.use-item { padding: 28rpx 0; border-bottom: 1rpx solid #e5e8e3; color: #7b8479; display: grid; grid-template-columns: 70rpx 1fr; gap: 12rpx; }
.use-title, .use-copy { display: block; }
.use-title { color: #33342e; font-size: 29rpx; font-weight: 700; }
.use-copy { margin-top: 10rpx; color: #746f60; font-size: 23rpx; line-height: 1.6; }
.detail-quick-actions { position: fixed; z-index: 20; left: 24rpx; bottom: 30rpx; padding-bottom: env(safe-area-inset-bottom); display: flex; gap: 10rpx; }
.quick-action { width: 170rpx; height: 76rpx; border: 1rpx solid #e1e6df; border-radius: 38rpx; background: rgba(255,255,255,.96); box-shadow: 0 12rpx 32rpx rgba(38,43,37,.10); color: #465046; font-size: 21rpx; display: flex; align-items: center; justify-content: center; }
.detail-fab-stack { position: fixed; z-index: 22; right: 36rpx; bottom: 122rpx; width: 196rpx; max-width: calc(100vw - 72rpx); margin-bottom: env(safe-area-inset-bottom); display: flex; flex-direction: column; align-items: flex-end; gap: 12rpx; }
.detail-fab { box-sizing: border-box; width: 196rpx; min-width: 196rpx; max-width: 196rpx; height: 76rpx; overflow: hidden; border-radius: 38rpx; box-shadow: 0 14rpx 34rpx rgba(35,35,31,.18); font-size: 22rpx; font-weight: 700; white-space: nowrap; display: flex; align-items: center; justify-content: center; gap: 7rpx; }
.favorite-fab { border: 1rpx solid #e1e6df; background: rgba(255,255,255,.97); color: #4b5549; }
.favorite-fab.is-favorite { border-color: #b94747; background: #b94747; color: #fff; }
.favorite-heart { font-size: 26rpx; }
.sample-fab { background: #20231f; color: #fff; }
.sample-fab-plus { font-size: 28rpx; font-weight: 400; }
.detail-load-error { min-height: 100vh; padding: 240rpx 56rpx; text-align: center; display: flex; flex-direction: column; align-items: center; }
.detail-load-error .empty-title, .detail-load-error .empty-copy { display: block; }
.detail-load-error .empty-title { font-family: "Songti SC", serif; font-size: 38rpx; font-weight: 700; }
.detail-load-error .empty-copy { margin: 18rpx 0 36rpx; color: #777363; font-size: 24rpx; }
