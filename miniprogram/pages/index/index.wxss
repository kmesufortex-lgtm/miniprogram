.home-page { padding-right: 24rpx; padding-left: 24rpx; }

.poster-wrap { position: relative; margin-top: 22rpx; }
.poster-swiper { height: 860rpx; }
.poster { position: relative; height: 100%; color: #fff; }
.poster-image, .poster-shade { position: absolute; width: 100%; height: 100%; }
.poster-image { transform: scale(1.06); transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
.poster-image.is-active { transform: scale(1); }
.poster-shade { background: linear-gradient(180deg, rgba(29,29,25,.04) 18%, rgba(23,23,20,.82) 100%); }
.poster-content { position: absolute; right: 36rpx; bottom: 54rpx; left: 36rpx; display: flex; flex-direction: column; align-items: flex-start; }
.hero-kicker { margin-bottom: 18rpx; font-size: 21rpx; font-weight: 700; letter-spacing: 4rpx; }
.poster-title { max-width: 590rpx; font-family: "Songti SC", "STSong", serif; font-size: 56rpx; font-weight: 700; line-height: 1.22; }
.poster-copy { margin-top: 20rpx; color: rgba(255,255,255,.82); font-size: 25rpx; line-height: 1.7; }
.poster-cta { min-height: 70rpx; margin-top: 30rpx; padding: 0 26rpx; border-radius: 35rpx; background: #ffffff; color: #20231f; font-size: 24rpx; font-weight: 700; display: flex; align-items: center; gap: 28rpx; }

.carousel-dots { position: absolute; right: 0; bottom: 22rpx; left: 0; z-index: 4; display: flex; justify-content: center; gap: 10rpx; }
.carousel-dot { width: 10rpx; height: 10rpx; border-radius: 8rpx; background: rgba(255,255,255,.55); transition: width .35s ease, background .35s ease; }
.carousel-dot.is-active { width: 34rpx; background: #fff; }
.ink-dots { position: static; margin-top: 18rpx; }
.ink-dots .carousel-dot { background: #c5c0b1; }
.ink-dots .carousel-dot.is-active { background: #5f5c50; }

.section-note { color: #8a846f; font-size: 22rpx; }
.product-swiper { height: 850rpx; margin: 0 -18rpx; }
.product-slide { height: 100%; padding: 0 10rpx; transform: scale(.965); opacity: .72; transition: transform .45s ease, opacity .45s ease; }
.product-slide.is-active { transform: scale(1); opacity: 1; }
.hot-product-card { position: relative; height: 100%; color: #fff; }
.hot-product-image, .hot-product-shade { position: absolute; width: 100%; height: 100%; }
.hot-product-image { transform: scale(1.055); transition: transform 1s cubic-bezier(.2,.7,.2,1); }
.hot-product-image.is-active { transform: scale(1); }
.hot-product-shade { background: linear-gradient(180deg, rgba(18,18,15,.02) 24%, rgba(18,18,15,.86) 100%); }
.hot-product-content { position: absolute; right: 38rpx; bottom: 42rpx; left: 38rpx; display: flex; flex-direction: column; align-items: flex-start; }
.hot-product-code { font-size: 21rpx; font-weight: 700; letter-spacing: 4rpx; }
.hot-product-name { margin-top: 18rpx; font-family: "Songti SC", serif; font-size: 47rpx; font-weight: 700; line-height: 1.25; }
.hot-product-copy { margin-top: 20rpx; color: rgba(255,255,255,.76); font-size: 24rpx; line-height: 1.7; display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
.hot-product-cta { min-height: 72rpx; margin-top: 28rpx; padding: 0 26rpx; border-radius: 36rpx; color: #3d453c; background: #eef1ec; font-size: 24rpx; font-weight: 700; display: flex; align-items: center; gap: 28rpx; }
.product-card { height: 100%; display: flex; flex-direction: column; }
.product-image { width: 100%; height: 500rpx; flex: 0 0 500rpx; }
.product-content { min-height: 0; padding: 28rpx 30rpx 30rpx; flex: 1; display: flex; flex-direction: column; }
.product-topline, .product-footer { display: flex; align-items: center; justify-content: space-between; }
.product-code { color: #8a846f; font-family: Georgia, serif; font-size: 24rpx; font-style: italic; }
.product-name { display: block; margin-top: 22rpx; font-family: "Songti SC", serif; font-size: 40rpx; font-weight: 700; }
.product-meta { display: block; margin-top: 11rpx; color: #777363; font-size: 24rpx; }
.product-footer { margin-top: auto; padding-top: 22rpx; border-top: 1rpx solid #e5e8e3; color: #667064; font-size: 22rpx; }
.product-footer > text { max-width: 510rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.round-arrow { width: 58rpx; height: 58rpx; flex: 0 0 58rpx; border-radius: 29rpx; background: #20231f; color: #fff; display: flex; align-items: center; justify-content: center; }
.new-pill { color: #fff; background: #817a61; letter-spacing: 2rpx; }

.case-swiper { height: 740rpx; }
.look-grid { height: 100%; display: grid; grid-template-columns: 1.1fr .9fr; grid-template-rows: 310rpx 414rpx; gap: 16rpx; opacity: .72; transform: translateY(12rpx); transition: opacity .5s ease, transform .5s ease; }
.look-grid.is-active { opacity: 1; transform: none; }
.look { width: 100%; height: 100%; border-radius: 28rpx; }
.look-tall { grid-row: 1 / 3; }
.look-detail { filter: saturate(.8); }
.look-copy { padding: 28rpx; display: flex; flex-direction: column; justify-content: space-between; }
.look-number { font-family: Georgia, serif; font-size: 34rpx; font-style: italic; }
.look-title, .look-label { display: block; }
.look-title { margin-bottom: 9rpx; font-family: "Songti SC", serif; font-size: 27rpx; font-weight: 700; line-height: 1.35; }
.look-label { color: #6e6a5b; font-size: 21rpx; line-height: 1.5; }

.consult-card { padding: 42rpx 34rpx; background: #ded8c8; }
.consult-title { display: block; font-family: "Songti SC", serif; font-size: 42rpx; font-weight: 700; }
.consult-copy { display: block; margin: 18rpx 0 30rpx; color: #666254; font-size: 25rpx; line-height: 1.7; }

@media (prefers-reduced-motion: reduce) {
  .poster-image, .hot-product-image, .product-slide, .look-grid, .carousel-dot { transition: none; }
}
