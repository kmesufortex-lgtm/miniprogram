.login-page {
  min-height: 100vh;
  padding: 108rpx 34rpx calc(env(safe-area-inset-bottom) + 48rpx);
  background: #ffffff;
}

.login-topbar {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.login-back {
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid #e2e8e2;
  border-radius: 36rpx;
  color: #27322b;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-topbar-label {
  color: #7a847c;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.login-hero {
  padding: 96rpx 14rpx 62rpx;
}

.login-brand-mark {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 38rpx;
  border-radius: 12rpx 25rpx 12rpx 25rpx;
  background: #506558;
  transform: rotate(8deg);
}

.login-brand-core {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: 15rpx;
  height: 15rpx;
  border-radius: 50%;
  background: #b4ca79;
}

.login-eyebrow {
  display: block;
  margin-bottom: 18rpx;
  color: #758c7b;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.login-title {
  display: block;
  max-width: 570rpx;
  color: #172019;
  font-family: "Songti SC", "STSong", serif;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.28;
}

.login-copy {
  display: block;
  max-width: 610rpx;
  margin-top: 24rpx;
  color: #6f7771;
  font-size: 26rpx;
  line-height: 1.8;
}

.login-card {
  padding: 18rpx 30rpx 30rpx;
  border: 1rpx solid #e1e8e2;
  border-radius: 34rpx;
  background: #fbfcfb;
  box-shadow: 0 24rpx 64rpx rgba(54, 77, 62, 0.08);
}

.login-benefit {
  min-height: 132rpx;
  padding: 28rpx 4rpx;
  border-bottom: 1rpx solid #e8ede9;
  display: flex;
  gap: 24rpx;
}

.benefit-index {
  width: 48rpx;
  padding-top: 4rpx;
  color: #90a294;
  font-family: Georgia, serif;
  font-size: 21rpx;
  letter-spacing: 2rpx;
}

.benefit-title,
.benefit-copy {
  display: block;
}

.benefit-title {
  color: #202b23;
  font-size: 27rpx;
  font-weight: 700;
}

.benefit-copy {
  margin-top: 9rpx;
  color: #818982;
  font-size: 22rpx;
  line-height: 1.55;
}

.wechat-login {
  height: 92rpx;
  margin-top: 32rpx;
  border-radius: 46rpx;
  background: #4e6857;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 28rpx rgba(65, 94, 73, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.wechat-login[disabled] {
  background: #829087;
  color: #ffffff;
}

.guest-back {
  width: 100%;
  height: 74rpx;
  color: #647068;
  font-size: 24rpx;
}

.login-note {
  display: block;
  padding: 30rpx 36rpx 0;
  color: #a0a6a1;
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}
