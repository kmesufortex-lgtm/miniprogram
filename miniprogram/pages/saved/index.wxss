.simple-page { width: 100%; min-height: 100vh; padding: 120rpx 28rpx 60rpx; box-sizing: border-box; }
.simple-topbar { position: relative; min-height: 106rpx; padding: 0 92rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.simple-topbar > view { min-width: 0; text-align: center; }
.back { position: absolute; left: 0; top: 20rpx; z-index: 2; width: 64rpx; height: 64rpx; border-radius: 50%; background: #fff; color: #22231f; font-size: 34rpx; line-height: 64rpx; text-align: center; }
.simple-title { display: block; margin-top: 8rpx; font-family: "Songti SC", serif; font-size: 38rpx; font-weight: 700; white-space: nowrap; }
.clear { position: absolute; right: 0; top: 22rpx; margin: 0; padding: 10rpx 0; color: #777263; font-size: 24rpx; line-height: 1.2; }
.saved-list { margin-top: 28rpx; }
.saved-card { display: flex; flex-direction: row; width: calc(100vw - 56rpx); min-height: 190rpx; margin: 0 0 20rpx; padding: 18rpx; color: #34352f; align-items: center; gap: 22rpx; box-sizing: border-box; text-align: left; }
.saved-card image { width: 154rpx; height: 154rpx; flex: 0 0 154rpx; border-radius: 22rpx; }
.saved-card > view { min-width: 0; flex: 1 1 auto; overflow: hidden; }
.saved-code, .saved-name, .saved-composition { display: block; }
.saved-code { color: #8b856f; font-size: 20rpx; letter-spacing: 2rpx; }
.saved-name { margin-top: 8rpx; font-family: "Songti SC", serif; font-size: 29rpx; font-weight: 700; line-height: 1.3; white-space: normal; word-break: break-all; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.saved-composition { margin-top: 10rpx; overflow: hidden; color: #777263; font-size: 19rpx; white-space: nowrap; text-overflow: ellipsis; }
.saved-arrow { padding: 16rpx; font-size: 28rpx; }
.empty-state { margin-top: 46rpx; }
.empty-swatch { width: 82rpx; height: 82rpx; margin: 0 auto 24rpx; border-radius: 12rpx 34rpx 12rpx 34rpx; background: #aaa48d; transform: rotate(8deg); }
.empty-title, .empty-copy { display: block; }
.empty-title { font-family: "Songti SC", serif; font-size: 32rpx; font-weight: 700; }
.empty-copy { margin-top: 14rpx; font-size: 22rpx; line-height: 1.7; }
